<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Shell" RequestedTheme="Dark" Background="#1c211f">
  <Grid.Resources>
    <ItemsPanelTemplate x:Key="LibraryRowPanel">
      <ItemsStackPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>
    <DataTemplate x:Key="DetailRowTemplate">
      <Grid/>
    </DataTemplate>
    <SolidColorBrush x:Key="Sage" Color="#c0d7ae"/>
    <SolidColorBrush x:Key="SettingsCardBackground" Color="#2a332d"/>
    <SolidColorBrush x:Key="SettingsCardBorder" Color="#39453d"/>
    <SolidColorBrush x:Key="Muted" Color="#acb8ae"/>
    <!-- Override the native Slider template resources, not only Foreground. -->
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#c0d7ae"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#c0d7ae"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#c0d7ae"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#65765e"/>
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#c0d7ae"/>
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#c0d7ae"/>
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#c0d7ae"/>
    <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#65765e"/>
    <SolidColorBrush x:Key="SliderTrackFill" Color="#526052"/>
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#526052"/>
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#526052"/>
    <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#526052"/>
    <!-- Android-style marker; the native Slider still owns track, input and states. -->
    <ControlTemplate x:Key="PlayerSliderThumbTemplate" TargetType="Thumb">
      <Grid Background="Transparent">
        <Border Width="12" Height="32" Background="#242c28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Border Width="4" Height="28" CornerRadius="2" Background="{TemplateBinding Background}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
    </ControlTemplate>
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#354239"/>
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#41513f"/>
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#354239"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#c0d7ae"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#c0d7ae"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#c0d7ae"/>
    <Style TargetType="FontIcon"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="18"/></Style>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#edf0e9"/></Style>
    <Style TargetType="Button"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="CornerRadius" Value="5"/></Style>
    <Style x:Key="NavigationButtonStyle" TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="42"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style x:Key="TransportButtonStyle" TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#edf0e9"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
      <Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style x:Key="TransportToggleStyle" TargetType="ToggleButton">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
      <Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="5"/>
    </Style>
    <!-- Keep the native Expander header part and automation/keyboard behavior;
         only its visual arrangement differs from the filled SDK card. -->
    <Style x:Key="PlayedDisclosureStyle" TargetType="Expander">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Expander">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="ExpandStates">
                <VisualState x:Name="ExpandDown"><VisualState.Setters>
                  <Setter Target="ExpanderContent.Visibility" Value="Visible"/>
                  <Setter Target="PlayedChevron.Data" Value="M 0,0 L 6,6 L 12,0 L 10.5,-1.5 L 6,3 L 1.5,-1.5 Z"/>
                </VisualState.Setters></VisualState>
                <VisualState x:Name="CollapseUp"/>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border BorderBrush="#39453d" BorderThickness="0,0,0,1">
              <ToggleButton x:Name="ExpanderHeader" MinHeight="54" Padding="10,0" Background="Transparent" BorderThickness="0" CornerRadius="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" UseSystemFocusVisuals="True"
                            IsEnabled="{TemplateBinding IsEnabled}" IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Resources>
                  <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent"/>
                  <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#20394233"/>
                  <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#30394233"/>
                </ToggleButton.Resources>
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <PathIcon x:Name="PlayedChevron" Width="12" Height="12" VerticalAlignment="Center" Data="M 0,0 L 6,6 L 0,12 L -1.5,10.5 L 3,6 L -1.5,1.5 Z"/>
                  <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Grid>
              </ToggleButton>
            </Border>
            <Border x:Name="ExpanderContentClip" Grid.Row="1">
              <Border x:Name="ExpanderContent" Visibility="Collapsed" Background="Transparent">
                <Border.RenderTransform><CompositeTransform/></Border.RenderTransform>
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"/>
              </Border>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="OutputRouteStyle" TargetType="RadioButton">
      <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="UseSystemFocusVisuals" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Card" Background="#242f28" BorderBrush="#778575" BorderThickness="1" CornerRadius="14" MinHeight="76" Padding="12">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Card.Opacity" Value="0.85"/></VisualState.Setters></VisualState>
                  <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Card.Opacity" Value="0.7"/></VisualState.Setters></VisualState>
                  <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Card.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                  <VisualState x:Name="Unchecked"/>
                  <VisualState x:Name="Checked"><VisualState.Setters>
                    <Setter Target="Card.Background" Value="#354239"/><Setter Target="Card.BorderBrush" Value="#c0d7ae"/>
                    <Setter Target="SelectedDot.Visibility" Value="Visible"/>
                  </VisualState.Setters></VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                <Grid Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center">
                  <Ellipse Stroke="#c0d7ae" StrokeThickness="2"/>
                  <Ellipse x:Name="SelectedDot" Fill="#c0d7ae" Width="10" Height="10" Visibility="Collapsed"/>
                </Grid>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="112"/></Grid.RowDefinitions>
  <Border x:Name="TitleBar" Background="#242c28" Padding="18,0,150,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Image x:Name="AppIcon" Width="22" Height="22" IsHitTestVisible="False"/><TextBlock Text="Music" VerticalAlignment="Center"/></StackPanel></Border>
  <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid Background="#242c28" Padding="12,22,12,16">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Spacing="6">
        <Button x:Name="LibraryNav" Style="{StaticResource NavigationButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE8F1;"/><TextBlock Text="Library"/></StackPanel></Button>
        <Button x:Name="PlaylistsNav" Style="{StaticResource NavigationButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE8FD;"/><TextBlock Text="Playlists"/></StackPanel></Button>
        <Button x:Name="AlbumsNav" Style="{StaticResource NavigationButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE93C;"/><TextBlock Text="Albums"/></StackPanel></Button>
        <Button x:Name="ArtistsNav" Style="{StaticResource NavigationButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE77B;"/><TextBlock Text="Artists"/></StackPanel></Button>
        <Button x:Name="SongsNav" Style="{StaticResource NavigationButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE8D6;"/><TextBlock Text="Songs"/></StackPanel></Button>
      </StackPanel>
      <Button Grid.Row="1" x:Name="SettingsNav" Style="{StaticResource NavigationButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE713;"/><TextBlock Text="Settings"/></StackPanel></Button>
    </Grid>
    <Grid Grid.Column="1" Padding="28,22,28,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="PageHeader" Margin="0,0,0,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="PageTitle" Text="Library" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
        <TextBox Grid.Column="1" x:Name="SearchBox" Width="260" PlaceholderText="Search your library" AutomationProperties.Name="Search library" VerticalAlignment="Center"/>
        <Button Grid.Column="2" x:Name="LayoutButton" Margin="10,0,0,0" AutomationProperties.Name="Change content view"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon x:Name="LayoutIcon" Symbol="ViewAll"/><FontIcon Glyph="&#xE70D;" FontSize="10"/></StackPanel><Button.Flyout><MenuFlyout><MenuFlyoutItem x:Name="GridOption" Text="Grid"/><MenuFlyoutItem x:Name="ListOption" Text="List"/></MenuFlyout></Button.Flyout></Button>
        <Button Grid.Row="1" Grid.ColumnSpan="3" x:Name="NewPlaylistButton" Visibility="Collapsed" Margin="0,12,0,0"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Add"/><TextBlock Text="New playlist"/></StackPanel></Button>
      </Grid>
      <StackPanel Grid.Row="1">
        <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Error" Margin="0,0,0,12"/>
        <InfoBar x:Name="PlaylistNotice" IsOpen="False" IsClosable="True" Severity="Success" Margin="0,0,0,12"/>
      </StackPanel>
      <ProgressBar Grid.Row="2" x:Name="BusyBar" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,12"/>
      <ScrollViewer Grid.Row="3" x:Name="MainScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">
          <StackPanel x:Name="WelcomePanel" Spacing="14" Margin="0,80,0,0" HorizontalAlignment="Center">
            <TextBlock Text="♪" FontSize="48" Foreground="{StaticResource Sage}" HorizontalAlignment="Center"/>
            <TextBlock Text="Connect your music server" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Your albums, playlists, and songs will appear here." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            <Button x:Name="WelcomeConnect" Content="Open connection settings" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="BrowsePanel" Spacing="24" Visibility="Collapsed"/>
          <StackPanel x:Name="SettingsPanel" Spacing="22" Visibility="Collapsed" MaxWidth="720" HorizontalAlignment="Stretch">
            <StackPanel Spacing="16"><TextBlock Text="Updates" FontSize="21" FontWeight="SemiBold"/>
              <ContentControl x:Name="UpdatesPanelHost" HorizontalContentAlignment="Stretch"/>
              <!-- The adapter moves this subtree into the shared panel before Loaded. -->
              <ContentControl x:Name="ChangelogParkingHost" Visibility="Collapsed">
                <Expander x:Name="UpdateChangelog" Header="What’s new" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="12">
                    <TextBlock x:Name="ChangelogStatus" Text="Check for updates to load changes." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="RetryChangelogButton" Content="Check again" Visibility="Collapsed"/>
                    <StackPanel x:Name="ChangelogContent" Spacing="12">
                      <StackPanel.Resources>
                        <ResourceDictionary>
                          <!-- Scoped native HyperlinkButton states: do not recolor other shell links. -->
                          <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                              <SolidColorBrush x:Key="HyperlinkButtonBackground" Color="#2a312c"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBorderBrush" Color="#545e56"/>
                              <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#bbd8c1"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="#34483a"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBorderBrushPointerOver" Color="#8daf96"/>
                              <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#bbd8c1"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="#263e2f"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBorderBrushPressed" Color="#8daf96"/>
                              <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#bbd8c1"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBackgroundDisabled" Color="#2a312c"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBorderBrushDisabled" Color="#545e56"/>
                              <SolidColorBrush x:Key="HyperlinkButtonForegroundDisabled" Color="#7d8b80"/>
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                              <SolidColorBrush x:Key="HyperlinkButtonBackground" Color="#e5ebe4"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBorderBrush" Color="#819184"/>
                              <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#315e3d"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="#d5e4d5"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBorderBrushPointerOver" Color="#496e51"/>
                              <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#244f30"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="#c6d9c7"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBorderBrushPressed" Color="#496e51"/>
                              <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#244f30"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBackgroundDisabled" Color="#e5ebe4"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBorderBrushDisabled" Color="#a0aaa0"/>
                              <SolidColorBrush x:Key="HyperlinkButtonForegroundDisabled" Color="#758176"/>
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                              <SolidColorBrush x:Key="HyperlinkButtonBackground" Color="{ThemeResource SystemColorWindowColor}"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBorderBrush" Color="{ThemeResource SystemColorHotlightColor}"/>
                              <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{ThemeResource SystemColorHotlightColor}"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                              <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                              <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBackgroundDisabled" Color="{ThemeResource SystemColorWindowColor}"/>
                              <SolidColorBrush x:Key="HyperlinkButtonBorderBrushDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
                              <SolidColorBrush x:Key="HyperlinkButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
                            </ResourceDictionary>
                          </ResourceDictionary.ThemeDictionaries>
                          <!-- Keep the SDK template, keyboard activation, automation peer and focus visuals. -->
                          <Style x:Key="CommitLinkStyle" TargetType="HyperlinkButton">
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Background" Value="{ThemeResource HyperlinkButtonBackground}"/>
                            <Setter Property="BorderBrush" Value="{ThemeResource HyperlinkButtonBorderBrush}"/>
                            <Setter Property="Foreground" Value="{ThemeResource HyperlinkButtonForeground}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="4"/>
                            <Setter Property="Padding" Value="6,0"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="MinHeight" Value="24"/>
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="IsTabStop" Value="True"/>
                            <Setter Property="UseSystemFocusVisuals" Value="True"/>
                          </Style>
                        </ResourceDictionary>
                      </StackPanel.Resources>
                    </StackPanel>
                  </StackPanel>
                </Expander>
              </ContentControl>
              <Button x:Name="RecheckUpdateButton" Content="Check for a newer update" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Spacing="12"><TextBlock Text="Connection" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Connect to your Navidrome server over HTTPS. Your password is stored in Windows Credential Locker, never in the profile file." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              <Border Background="{StaticResource SettingsCardBackground}" BorderBrush="{StaticResource SettingsCardBorder}" BorderThickness="1" CornerRadius="6" Padding="20"><StackPanel Spacing="12">
                <TextBox x:Name="ConnectionName" Header="Connection name" PlaceholderText="Name"/>
                <TextBox x:Name="ServerAddress" Header="Server address" PlaceholderText="https://" InputScope="Url"/>
                <TextBox x:Name="Username" Header="Username"/>
                <PasswordBox x:Name="Password" Header="Password"/>
                <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="ConnectButton" Content="Connect"/><Button x:Name="CancelConnectButton" Content="Cancel" Visibility="Collapsed"/></StackPanel>
                <TextBlock x:Name="ConnectionStatus" Text="Not connected" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
              </StackPanel></Border>
            </StackPanel>
            <StackPanel Spacing="10"><TextBlock Text="Connection info" FontSize="21" FontWeight="SemiBold"/><Border Background="{StaticResource SettingsCardBackground}" BorderBrush="{StaticResource SettingsCardBorder}" BorderThickness="1" CornerRadius="6" Padding="20"><StackPanel Spacing="8"><TextBlock x:Name="ConnectionInfo" Text="No saved connection." TextWrapping="Wrap"/><Button x:Name="TestConnectionButton" Content="Test connection" IsEnabled="False" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <!-- A finite viewport is required for native row virtualization. -->
      <Grid Grid.Row="3" x:Name="DetailHost" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="12">
          <Grid x:Name="CollectionHeader" Visibility="Collapsed" ColumnSpacing="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="CollectionCover" Width="120" Height="120" VerticalAlignment="Top"/>
            <Grid Grid.Column="1" RowSpacing="5">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel Spacing="4" VerticalAlignment="Top">
                <Grid HorizontalAlignment="Left">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="CollectionTitle" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level1"/>
                  <Border Grid.Column="1" x:Name="CollectionDeviceBadge" Visibility="Collapsed" Margin="6,0,0,0"/>
                </Grid>
                <TextBlock x:Name="CollectionSummary" FontSize="13" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Border Grid.Row="1" x:Name="CollectionActions"/>
            </Grid>
          </Grid>
          <StackPanel x:Name="DetailHeader" Spacing="12"/>
        </StackPanel>
        <ListView Grid.Row="1" x:Name="DetailList" SelectionMode="None" IsItemClickEnabled="True"
                  ItemTemplate="{StaticResource DetailRowTemplate}" Padding="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                  AutomationProperties.Name="Collection songs"/>
        <GridView Grid.Row="1" x:Name="ArtistAlbumList" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True"
                  ItemTemplate="{StaticResource DetailRowTemplate}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                  AutomationProperties.Name="Artist albums"/>
      </Grid>
    </Grid>
    <Border Grid.Column="2" x:Name="QueuePane" Width="292" Visibility="Collapsed" BorderBrush="#39453d" BorderThickness="1,0,0,0" Background="#242c28" Padding="16">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,12"><TextBlock Text="Queue" FontSize="20" FontWeight="SemiBold"/><Button x:Name="CloseQueueButton" Content="&#xE8BB;" Style="{StaticResource TransportButtonStyle}" HorizontalAlignment="Right" AutomationProperties.Name="Close queue"/></Grid><ListView Grid.Row="1" x:Name="QueueList" ItemTemplate="{StaticResource DetailRowTemplate}" SelectionMode="Single" IsItemClickEnabled="True"/></Grid>
    </Border>
  </Grid>
  <Border Grid.Row="2" Background="#242c28" BorderBrush="#39453d" BorderThickness="0,1,0,0" Padding="18,7,18,8">
    <Grid x:Name="PlayerComposition">
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <!-- Keep Play centered while letting metadata use the space up to Previous. -->
      <Grid x:Name="PlayerTransportRow" ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid x:Name="PlayerMetadata">
            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="44" Height="44" Background="#354239" CornerRadius="4"><Image x:Name="CurrentArt" Stretch="UniformToFill"/></Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
              <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TrackTitle" Text="Nothing playing" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1" x:Name="TrackDeviceBadge" Visibility="Collapsed" Margin="6,0,0,0"/>
              </Grid>
              <TextBlock x:Name="TrackArtist" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Grid>
          <Button Grid.Column="1" x:Name="PreviousButton" Style="{StaticResource TransportButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Previous track">
            <PathIcon Width="16" Height="16" Data="M 0,0 L 2,0 L 2,16 L 0,16 Z M 4,8 L 16,0 L 16,16 Z"/>
          </Button>
        </Grid>
        <Button Grid.Column="1" x:Name="PlayButton" Style="{StaticResource TransportButtonStyle}" Background="{StaticResource Sage}" Foreground="#24341f" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Center" AutomationProperties.Name="Play">
          <Grid Width="16" Height="18">
            <PathIcon x:Name="PlayerPlayIcon" Width="16" Height="18" Data="M 2,0 L 16,9 L 2,18 Z"/>
            <PathIcon x:Name="PlayerPauseIcon" Visibility="Collapsed" Width="16" Height="18" Data="M 1,0 L 6,0 L 6,18 L 1,18 Z M 10,0 L 15,0 L 15,18 L 10,18 Z"/>
          </Grid>
        </Button>
        <Grid Grid.Column="2" ColumnSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button x:Name="NextButton" Style="{StaticResource TransportButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Next track">
              <PathIcon Width="16" Height="16" Data="M 0,0 L 12,8 L 0,16 Z M 14,0 L 16,0 L 16,16 Z"/>
            </Button>
            <ToggleButton x:Name="RepeatButton" Content="&#xE8EE;" Style="{StaticResource TransportToggleStyle}" VerticalAlignment="Center" AutomationProperties.Name="Repeat queue"/>
            <Button x:Name="PlayerRatingButton" Width="40" MinHeight="36" Padding="4,0" VerticalAlignment="Center" Visibility="Collapsed" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Rate current song"/>
          </StackPanel>
          <Button Grid.Column="1" x:Name="QueueButton" MinHeight="48" MinWidth="48" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="12,8" AutomationProperties.Name="Queue"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8FD;" FontSize="26" VerticalAlignment="Center"/><TextBlock Text="Queue" FontSize="18" VerticalAlignment="Center"/></StackPanel></Button>
        </Grid>
      </Grid>
      <Grid Grid.Row="1" x:Name="PlayerSeekRow" ColumnSpacing="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*" MinWidth="328"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="OutputButton" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalAlignment="Center" MaxWidth="320" MinWidth="0" MinHeight="48" Background="Transparent" Foreground="{StaticResource Sage}" BorderThickness="0" Padding="4,0" CornerRadius="24" AutomationProperties.Name="Choose audio output, System default output">
          <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7F4;" FontSize="22" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Media output" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock x:Name="OutputName" Text="System default output" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Sage}"/></StackPanel></Grid>
        </Button>
        <Grid Grid.Column="1" MaxWidth="620" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock x:Name="ElapsedText" Text="0:00" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11"/><Slider Grid.Column="1" x:Name="SeekSlider" Minimum="0" Maximum="1" IsEnabled="False" AutomationProperties.Name="Playback position"/><TextBlock Grid.Column="2" x:Name="DurationText" Text="0:00" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/></Grid>
      </Grid>
    </Grid>
  </Border>
  <InfoBar Grid.Row="1" x:Name="RatingNotice" Margin="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="430" Severity="Error" IsOpen="False" IsClosable="True" Canvas.ZIndex="2"/>
</Grid>

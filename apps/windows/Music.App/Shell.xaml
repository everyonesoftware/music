<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Shell" RequestedTheme="Dark" Background="#1c211f">
  <Grid.Resources>
    <SolidColorBrush x:Key="Sage" Color="#c0d7ae"/>
    <SolidColorBrush x:Key="Muted" Color="#acb8ae"/>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#edf0e9"/></Style>
    <Style TargetType="Button"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="CornerRadius" Value="5"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="132"/></Grid.RowDefinitions>
  <Border x:Name="TitleBar" Background="#242c28" Padding="18,0,150,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Text="♪" Foreground="{StaticResource Sage}" FontSize="21"/><TextBlock Text="Music" VerticalAlignment="Center"/></StackPanel></Border>
  <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid Background="#242c28" Padding="12,22,12,16">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Spacing="6">
        <Button x:Name="LibraryNav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE8F1;"/><TextBlock Text="Library"/></StackPanel></Button>
        <Button x:Name="PlaylistsNav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE8FD;"/><TextBlock Text="Playlists"/></StackPanel></Button>
        <Button x:Name="AlbumsNav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE93C;"/><TextBlock Text="Albums"/></StackPanel></Button>
        <Button x:Name="SongsNav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="♪" FontSize="21" Width="20"/><TextBlock Text="Songs"/></StackPanel></Button>
      </StackPanel>
      <Button Grid.Row="1" x:Name="SettingsNav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE713;"/><TextBlock Text="Settings"/></StackPanel></Button>
    </Grid>
    <Grid Grid.Column="1" Padding="28,22,28,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="PageTitle" Text="Library" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" x:Name="SearchBox" PlaceholderText="Search your library" AutomationProperties.Name="Search library" VerticalAlignment="Center"/>
        <Button Grid.Column="2" x:Name="LayoutButton" Content="▦  ⌄" Margin="10,0,0,0" AutomationProperties.Name="Change content view"><Button.Flyout><MenuFlyout><MenuFlyoutItem x:Name="GridOption" Text="Grid"/><MenuFlyoutItem x:Name="ListOption" Text="List"/></MenuFlyout></Button.Flyout></Button>
      </Grid>
      <InfoBar Grid.Row="1" x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Error" Margin="0,0,0,12"/>
      <ProgressBar Grid.Row="2" x:Name="BusyBar" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,12"/>
      <ScrollViewer Grid.Row="3" x:Name="MainScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">
          <StackPanel x:Name="WelcomePanel" Spacing="14" Margin="0,80,0,0" HorizontalAlignment="Center">
            <TextBlock Text="♪" FontSize="48" Foreground="{StaticResource Sage}" HorizontalAlignment="Center"/>
            <TextBlock Text="Connect your music server" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Your albums, playlists, and songs will appear here." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            <Button x:Name="WelcomeConnect" Content="Open connection settings" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="BrowsePanel" Spacing="24" Visibility="Collapsed"/>
          <StackPanel x:Name="SettingsPanel" Spacing="22" Visibility="Collapsed" MaxWidth="720" HorizontalAlignment="Stretch">
            <StackPanel Spacing="12"><TextBlock Text="Connection" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Connect to your Navidrome server over HTTPS. Your password is stored in Windows Credential Locker, never in the profile file." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              <Border Background="#2a332d" BorderBrush="#39453d" BorderThickness="1" CornerRadius="6" Padding="20"><StackPanel Spacing="12">
                <TextBox x:Name="ConnectionName" Header="Connection name" PlaceholderText="Name"/>
                <TextBox x:Name="ServerAddress" Header="Server address" PlaceholderText="https://" InputScope="Url"/>
                <TextBox x:Name="Username" Header="Username"/>
                <PasswordBox x:Name="Password" Header="Password"/>
                <StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="ConnectButton" Content="Connect"/><Button x:Name="CancelConnectButton" Content="Cancel" Visibility="Collapsed"/></StackPanel>
                <TextBlock x:Name="ConnectionStatus" Text="Not connected" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
              </StackPanel></Border>
            </StackPanel>
            <StackPanel Spacing="10"><TextBlock Text="Connection info" FontSize="21" FontWeight="SemiBold"/><Border Background="#2a332d" BorderBrush="#39453d" BorderThickness="1" CornerRadius="6" Padding="20"><StackPanel Spacing="8"><TextBlock x:Name="ConnectionInfo" Text="No saved connection." TextWrapping="Wrap"/><Button x:Name="TestConnectionButton" Content="Test connection" IsEnabled="False" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel>
            <StackPanel Spacing="10"><TextBlock Text="Updates" FontSize="21" FontWeight="SemiBold"/><Border Background="#2a332d" BorderBrush="#39453d" BorderThickness="1" CornerRadius="6" Padding="20"><StackPanel Spacing="8"><TextBlock x:Name="VersionText" Text="Music for Windows"/><TextBlock Text="Automatic updates are not enabled yet" Foreground="{StaticResource Muted}"/><TextBlock Text="Installer packages use Velopack. Update checks are not available in this build." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Column="2" x:Name="QueuePane" Width="292" Visibility="Collapsed" BorderBrush="#39453d" BorderThickness="1,0,0,0" Background="#242c28" Padding="16">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,12"><TextBlock Text="Queue" FontSize="20" FontWeight="SemiBold"/><Button x:Name="CloseQueueButton" Content="×" HorizontalAlignment="Right" AutomationProperties.Name="Close queue"/></Grid><ListView Grid.Row="1" x:Name="QueueList" SelectionMode="Single" IsItemClickEnabled="True"/></Grid>
    </Border>
  </Grid>
  <Border Grid.Row="2" Background="#242c28" BorderBrush="#39453d" BorderThickness="0,1,0,0" Padding="18,12">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" Background="#354239" CornerRadius="4"><Image x:Name="CurrentArt" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="TrackTitle" Text="Nothing playing" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TrackArtist" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel></Grid><Button x:Name="OutputButton" Content="◖  System default output  ⌃" HorizontalAlignment="Left" FontSize="11" AutomationProperties.Name="Choose audio output"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="20,0" Spacing="4"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8"><ToggleButton x:Name="ShuffleButton" Content="⤨" AutomationProperties.Name="Shuffle"/><Button x:Name="PreviousButton" Content="&#xE892;" FontFamily="Segoe MDL2 Assets" AutomationProperties.Name="Previous track"/><Button x:Name="PlayButton" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" Background="{StaticResource Sage}" Foreground="#24341f" Width="48" AutomationProperties.Name="Play"/><Button x:Name="NextButton" Content="&#xE893;" FontFamily="Segoe MDL2 Assets" AutomationProperties.Name="Next track"/><ToggleButton x:Name="RepeatButton" Content="↻" AutomationProperties.Name="Repeat queue"/></StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock x:Name="ElapsedText" Text="0:00" VerticalAlignment="Center" FontSize="11"/><Slider Grid.Column="1" x:Name="SeekSlider" Minimum="0" Maximum="1" IsEnabled="False" AutomationProperties.Name="Playback position"/><TextBlock Grid.Column="2" x:Name="DurationText" Text="0:00" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/></Grid></StackPanel>
      <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="8"><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="70" Width="150" AutomationProperties.Name="Volume"/><Button x:Name="QueueButton" Content="☷  Queue" HorizontalAlignment="Right"/></StackPanel>
    </Grid>
  </Border>
</Grid>

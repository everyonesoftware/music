<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <!-- Runtime XAML still needs the merged WinUI theme PRI in native releases. -->
    <AppxGeneratePriEnabled Condition="'$(OS)' == 'Windows_NT'">true</AppxGeneratePriEnabled>
    <AppxGeneratePriEnabled Condition="'$(OS)' != 'Windows_NT'">false</AppxGeneratePriEnabled>
    <AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Music.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Music.App</RootNamespace>
    <AssemblyName>Music</AssemblyName>
    <Version>0.1.0</Version>
    <PublishTrimmed>false</PublishTrimmed>
    <MusicTrimmed Condition="'$(MusicTrimmed)' == ''">false</MusicTrimmed>
  </PropertyGroup>
  <!-- Experimental until a native installed-app/upgrade acceptance run passes.
       Partial mode trims opt-in/framework assemblies, not arbitrary dependencies. -->
  <PropertyGroup Condition="'$(MusicTrimmed)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <DynamicCodeSupport>false</DynamicCodeSupport>
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
  </PropertyGroup>
  <ItemGroup Condition="'$(MusicTrimmed)' == 'true'">
    <!-- XamlReader resolves controls/properties by name at runtime. Keep the
         complete WinUI metadata provider; generate application WinRT marshalling
         instead of retaining unsupported reflection-based generic fallbacks. -->
    <TrimmerRootAssembly Include="Microsoft.WinUI" />
  </ItemGroup>
  <PropertyGroup Condition="'$(MusicNativeAcceptance)' == 'true'">
    <DefineConstants>$(DefineConstants);MUSIC_NATIVE_ACCEPTANCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(MusicNativeAcceptance)' == 'true'">
    <Compile Include="../validation/native/*.cs" Link="NativeAcceptance/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Music.Core/Music.Core.csproj" />
    <!-- Keep the same WinUI version as the former umbrella package, but do not
         deploy its unused AI, ML, widgets, DWrite or full-runtime payloads. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="EveryoneSoftware.WindowsCommon" Version="[0.1.5]" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <EmbeddedResource Include="Shell.xaml" LogicalName="Music.App.Shell.xaml" />
    <!-- WinUI and the SDK already include image content; keep one PRI entry per asset. -->
    <Content Remove="Assets/Music.ico;Assets/Music.png" />
    <None Remove="Assets/Music.ico;Assets/Music.png" />
    <Content Include="Assets/Music.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets/Music.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishMergedWinUIResources" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT'">
    <!-- The PRI targets generate this after the SDK computes its publish inventory. -->
    <Error Condition="!Exists('$(ProjectPriFullPath)')" Text="Native Windows publish requires the generated merged WinUI resource index." />
    <Copy SourceFiles="$(ProjectPriFullPath)" DestinationFiles="$(PublishDir)resources.pri" />
  </Target>
</Project>

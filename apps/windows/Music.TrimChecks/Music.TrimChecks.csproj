<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <DynamicCodeSupport>false</DynamicCodeSupport>
    <TrimMode>partial</TrimMode>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Music.Core/Music.Core.csproj" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Compile Include="../Music.App/WindowsUpdateBackend.cs" Link="WindowsUpdateBackend.cs" />
    <Compile Include="../Music.App/WindowsChangelogClient.cs" Link="WindowsChangelogClient.cs" />
  </ItemGroup>
</Project>
